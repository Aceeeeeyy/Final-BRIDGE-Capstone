# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key             # safe to expose to a browser, but not used there in this app — only auth.js's login check uses it, server-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose this on the frontend

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-64-chars

# ── AI Provider Selection ──────────────────────────────────────
# Which AI service the AI Intervention analyzer should call.
# Supported values: claude | openai (or chatgpt) | deepseek | gemini
AI_PROVIDER=claude

# ── Anthropic (Claude AI) ─────────────────────────────────────
# Found in: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (ChatGPT) ───────────────────────────────────────────
# Found in: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# ── DeepSeek ───────────────────────────────────────────────────
# Found in: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# ── Google Gemini ──────────────────────────────────────────────
# Found in: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Server ────────────────────────────────────────────────────
PORT=3000
CLIENT_URL=http://localhost:5173
